{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "display_host": true
          },
          "template": "<green>\u250c\u2500\u2500(</>{{ if .Root }}root💀{{ else }}{{ .UserName }}@{{ end }}{{ .HostName }}<green>)</>",
          "foreground": "lightBlue",
          "type": "session",
          "style": "plain",
          "foreground_templates": [
            "{{ if .Root }}red{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": false,
            "fetch_virtual_env": true
          },
          "template": "<green>-[</>\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }}{{ end }}{{ .Full }}{{ end }}<green>]</>",
          "foreground": "yellow",
          "type": "python",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": "<#c0c0c0>/</>",
            "style": "full"
          },
          "template": "<green>-[</>\uf07b {{ .Path }}<green>]</>",
          "foreground": "lightWhite",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<green>-[</>{{ .HEAD }}<green>]</>",
          "foreground": "white",
          "type": "git",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none",
            "style": "round"
          },
          "template": " {{ .FormattedMs }} ",
          "foreground": "white",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": " {{ if gt .Code 0 }}\u2a2f{{else}}✓{{ end }} ",
          "foreground": "green",
          "type": "exit",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}red{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<green>\u2514\u2500</>{{ if .Root }}<red>#</>{{ else }}${{ end }} ",
          "foreground": "lightBlue",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
